# Copy to .env and fill in for production. Never commit the real .env file.

# Leave unset to use local SQLite (smartopd.db). Set to a Postgres URL for
# production, e.g. from Neon.tech or Supabase free tier:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Long random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Password for the auto-created "admin" account on first startup. Change
# it via the app after first login, then remove this or set a new value.
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

ACCESS_TOKEN_EXPIRE_MINUTES=480
